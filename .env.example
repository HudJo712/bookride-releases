APP_ENV=dev

# Database
POSTGRES_USER=app
POSTGRES_PASSWORD=dev123
POSTGRES_DB=bookandride
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_URL=postgresql+psycopg2://app:dev123@db:5432/bookandride

# API key settings
API_KEY_HEADER=X-API-Key
API_KEY_PEPPER=change-me-pepper

# First-party JWT settings
JWT_ISS=https://bookandride.local
JWT_AUD=bookandride-clients
JWT_HS256_SECRET=replace-with-strong-secret
JWT_ALG=HS256
JWT_ACCESS_TTL_SECONDS=900

# Optional OAuth/OIDC integration
OIDC_ISS=
OIDC_AUD=
OIDC_JWKS_URL=
REQUIRED_PARTNER_SCOPES=

# Elasticsearch / logging
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_HOSTS=http://elasticsearch:9200
ELASTIC_VERSION=8.13.4
ELASTICSEARCH_LOG_INDEX=logs-demo
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=elastic
KIBANA_SYSTEM_USERNAME=kibana_system
KIBANA_SYSTEM_PASSWORD=changeme-kibana-system
ELASTICSEARCH_SSL_VERIFICATIONMODE=none
ELASTICSEARCH_TIMEOUT=2
ELASTICSEARCH_SSL_VERIFY=false
SERVICE_NAME=bookride-api
BOOKRIDE_LOG_LEVEL=INFO

BOOKRIDE_DISABLE_ELASTIC=true

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Jenkins
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=admin123
STAGE_WEBHOOK_URL=https://discord.com/api/webhooks/1445403700007796826/FvWxaYLqi-1fdMa1ReVMqlo-W7BSZ1zq7rnt1idUdqAgeZPNv8Mdlk63rC1TgPlFz2uM

GRAFANA_WEBHOOK_URL=#https://discord.com/api/webhooks/
GRAFANA_WEBHOOK_LISTENER_URL=http://webhook-listener:8000/alerts
ALERT_CONTACT_NAME=Name

GITHUB_PAT=github_pat_
DOCKER_GID=1005
